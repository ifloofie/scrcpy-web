# Copy to .env and adjust. See README.md for every option.

# --- Network access (required) -----------------------------------------------
# This server's LAN IP address. The web UI is published only on this address,
# so it can't be reached via other interfaces (e.g. a public IPv6 address).
# Give the server a fixed IP / DHCP reservation in your router.
# Find it with:  ip -4 addr show | grep inet
BIND_ADDRESS=

# Which client addresses may connect. "private" = home/LAN ranges only
# (192.168.x.x, 10.x.x.x, 172.16-31.x.x, IPv6 fc00::/7, fe80::/10).
# Narrow it to your own subnet for extra safety, e.g. 192.168.1.0/24.
# Tailscale users: add 100.64.0.0/10. Never set this to "any".
ALLOWED_NETWORKS=private

# --- Web UI ---------------------------------------------------------------
# Password for the web UI. If unset, one is generated and printed in the logs.
WEB_PASSWORD=
# Token for scripts/automations: send "Authorization: Bearer <token>".
API_TOKEN=
# Wake the phone's screen whenever someone opens the web UI.
WAKE_ON_CONNECT=true
# PIN/password used by the Unlock button (otherwise you're asked each time).
UNLOCK_PIN=

# --- Phone / scrcpy ---------------------------------------------------------
# Only needed when more than one phone is plugged in (see `adb devices`).
ADB_SERIAL=
# Longest side of the mirrored video in pixels (0 = phone's native size).
MAX_SIZE=1280
MAX_FPS=30
VIDEO_BIT_RATE=8M
# Keep the phone awake while plugged in / turn its own screen off while mirroring.
STAY_AWAKE=true
SCREEN_OFF=false
# Any extra scrcpy flags, e.g. --show-touches
SCRCPY_ARGS=

# --- Native VNC (optional) -------------------------------------------------
# Setting a password opens port 5900 for VNC apps (max 8 characters).
VNC_PASSWORD=

# --- Remote ADB (optional) ---------------------------------------------------
# Let scrcpy/adb on another computer use this server's ADB (port 5037).
ADB_EXPOSE=false
